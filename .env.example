# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clean_bhopal_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# Auth - must be at least 32 random characters in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Aadhaar encryption. Aadhaar numbers are encrypted with AES-256-GCM and
# duplicate checks use a keyed HMAC. Generate both with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, both are derived from JWT_SECRET (development fallback only).
# AADHAAR_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key
# AADHAAR_LOOKUP_KEY=replace-with-a-different-32-byte-hex-key

# Comma-separated list of allowed browser origins, or * to allow all
CORS_ORIGIN=http://localhost:5000,http://localhost:5500,http://localhost:5501,http://localhost:5173

# Request handling
BODY_LIMIT=4mb
TRUST_PROXY=false

# Uploads (local disk by default)
MAX_UPLOAD_BYTES=2000000
# UPLOAD_DIR=backend/storage/uploads

# Password reset (token is returned in the response only outside production)
RESET_TOKEN_TTL_MINUTES=30
EXPOSE_RESET_TOKEN=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_MAX=25
UPLOAD_RATE_LIMIT_MAX=60

# Optional SMTP transport for automatic complaint emails.
# Leave SMTP_HOST empty to queue emails in the email_outbox table only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=Nagarik Bhopal <care@nagarik.bhopal>

# Frontend build options (npm run build)
# VITE_DATA_MODE=device turns the bundled UI back into its offline localStorage mode.
# VITE_API_URL=https://api.example.com points the UI at another API host.
